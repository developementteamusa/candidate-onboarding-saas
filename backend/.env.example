APP_NAME=Candidate Onboarding SaaS API
APP_ENV=development
APP_VERSION=0.2.0
DEBUG=true

API_V1_PREFIX=/api/v1

# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://teamdevusa_db_user:JV1EKg1lw4W0Ealw@cluster0.nm7jgdl.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=candidate_onboarding

FRONTEND_ORIGIN=http://localhost:3000

# JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_SECRET_KEY=680dfe4a76661a230f485413cfce3a8887e7fc5fad851d86276d60fbe5de8d9e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_COOKIE_NAME=onboarding_access_token
CSRF_COOKIE_NAME=onboarding_csrf_token


# Amazon SES will be our first AWS integration :
AWS_REGION=us-east-1
AWS_S3_REGION=us-east-1
AWS_TEXTRACT_REGION=us-east-1

# Let's use the following domain : https://www.capetownboutique.com/

# SES_FROM_EMAIL=no-reply@yourdomain.com
SES_FROM_EMAIL=no-reply@capetownboutique.com/
FRONTEND_PUBLIC_URL=http://localhost:3000
ONBOARDING_INVITATION_EXPIRE_HOURS=72

# use a dedicated private bucket :

AWS_S3_ONBOARDING_BUCKET=candidate-onboarding-secure-dev

AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:520324790703:key/7e0720b7-06ea-4a1c-b38d-c44d2f3b87dd

S3_PRESIGNED_URL_EXPIRE_SECONDS=300

# Maximum upload equals 10 MB :
S3_MAX_UPLOAD_BYTES=10485760


CANDIDATE_ACCESS_TOKEN_COOKIE_NAME=candidate_access_token
CANDIDATE_CSRF_COOKIE_NAME=candidate_csrf_token
CANDIDATE_ACCESS_TOKEN_EXPIRE_MINUTES=30

COOKIE_SECURE=false
COOKIE_SAMESITE=lax


