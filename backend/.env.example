APP_NAME=Candidate Onboarding SaaS API
APP_ENV=development
APP_VERSION=0.2.0
DEBUG=true

API_V1_PREFIX=/api/v1


MONGODB_URI=
MONGODB_DATABASE=candidate_onboarding

FRONTEND_ORIGIN=http://localhost:3000

# JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_COOKIE_NAME=onboarding_access_token
CSRF_COOKIE_NAME=onboarding_csrf_token


# Amazon SES will be our first AWS integration :
AWS_REGION=
AWS_S3_REGION=
AWS_TEXTRACT_REGION=

# Let's use the following domain : https://www.example.com/

SES_FROM_EMAIL=no-reply@yourdomain.com
FRONTEND_PUBLIC_URL=http://localhost:3000
ONBOARDING_INVITATION_EXPIRE_HOURS=72

# use a dedicated private bucket :

AWS_S3_ONBOARDING_BUCKET=candidate-onboarding-secure-dev

AWS_KMS_KEY_ID=arn:aws:kms

S3_PRESIGNED_URL_EXPIRE_SECONDS=300

# Maximum upload equals 10 MB :
S3_MAX_UPLOAD_BYTES=10485760


CANDIDATE_ACCESS_TOKEN_COOKIE_NAME=candidate_access_token
CANDIDATE_CSRF_COOKIE_NAME=candidate_csrf_token
CANDIDATE_ACCESS_TOKEN_EXPIRE_MINUTES=30

COOKIE_SECURE=false
COOKIE_SAMESITE=lax


