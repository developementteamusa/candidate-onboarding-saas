# ==========================================
# Candidate Onboarding SaaS - .gitignore
# ==========================================

# Environment / Secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# AWS local credentials / configuration
.aws/
aws_credentials
credentials

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.mypy_cache/
.pyright/
.ruff_cache/

# Next.js / Node.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
dist/
frontend/dist/
coverage/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Docker
*.pid
*.seed
*.pid.lock
docker-compose.override.yml
compose.override.yml

# Logs
logs/
*.log

# Temporary / Runtime Files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# VS Code / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml

# Jupyter / Python notebooks
.ipynb_checkpoints/

# MongoDB / local database artifacts
data/
mongodb-data/
mongo-data/

# Local uploads / test files
uploads/
test-uploads/
storage-test/
*.local.json

# Certificates / Keys / Secrets
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# AWS build artifacts
.aws-sam/
cdk.out/
.serverless/

# Misc generated files
*.cache
.cache/


# My notes 
notes/
images/
commands.txt